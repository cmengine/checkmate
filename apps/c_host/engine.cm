// The §9 schema fixture for the C host's codegen demo: `make schema-gen`
// runs `cme codegen-c` on this file and syntax-checks the result.

schema chost v1.0.0

struct TextureHandle {
    int id
}

struct Vec2 {
    float x
    float y
}

capability graphics {
    since 1.0.0 TextureHandle LoadTexture(str path)
    since 1.0.0 void DrawTexture(TextureHandle tex, Vec2 position)
}
