// The §9 schema fixture for the C host's codegen demo: `make schema-gen`
// runs `cme codegen-c` on this file, and the cme-ffi build script
// generates the SAME header at build time so `main.c` consumes it for
// real — REGISTER macro, pack/unpack helpers, and the typed interface
// invocation helpers all compile-checked against this contract.

schema chost 1.0.0

struct TextureHandle {
    int id
}

struct Vec2 {
    float x
    float y
}

enum Event {
    Started
    Scored(int points)
}

since 1.0.0 capability graphics {
    TextureHandle LoadTexture(str path)
    void DrawTexture(TextureHandle tex, Vec2 position)
}

since 1.0.0 interface hosthooks {
    int OnEvent(Event event)
    TextureHandle LastTexture()
}
