// The §9.1-shaped fixture the bindings test generates bindings from.
// Kept as a real file because the macro's contract IS reading real files.

schema engine 1.4.0

struct TextureHandle {
    int id
}

struct Vec2 {
    float x
    float y
}

struct GameConfig {
    int score
    bool active
}

struct GameState {
    int score
    bool active
}

enum LoadError {
    NotFound()
    Corrupt(str reason)
}

struct Inventory {
    str[] names
    map<str, int> counts
    option<str> label
    result<int, LoadError> attempt
}

since 1.0.0 capability graphics {
    TextureHandle LoadTexture(str path)
    void DrawTexture(TextureHandle tex, Vec2 position)
}

since 1.2.0 capability graphics {
    int DrawSprite(TextureHandle tex, Vec2 position, int frame)
}

since 1.3.0 capability graphics {
    option<TextureHandle> FindTexture(str path)
    result<Inventory, LoadError> LoadInventory(str owner)
    str[] TextureNames()
    map<str, float> TextureScales()
}

since 1.0.0 capability assets requires loader {
    TextureHandle LoadBundled(str name)
}

since 1.0.0 interface loader {
    bool IsAvailable(str name)
}

since 1.0.0 interface gamemode requires core {
    GameState InitGame(GameConfig config)
    void OnTick(GameState state, float deltaTime)
    result<int, LoadError> DamageRoll(int seed)
}

since 1.4.0 interface gamemode {
    optional void OnSave(str path)
}

since 1.0.0 interface core {
    void Tick()
}
