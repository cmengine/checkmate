// The §9.1-shaped fixture the cme_schema_setup! tests bootstrap from.
// Kept as a real file because the macro's contract IS reading real files.

schema demo 1.2.0

struct Greeting {
    str text
    int loudness
}

since 1.0.0 capability speaker {
    void Shout(str message)
    Greeting Compose(str name)
}

since 1.0.0 interface reporter {
    int Report(int value)
}

since 1.2.0 interface reporter {
    optional void Snapshot(str path)
}
