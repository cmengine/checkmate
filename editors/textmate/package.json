{
	"name": "checkmate",
	"displayName": "Checkmate Language",
	"description": "Syntax highlighting for Checkmate (CME) — the static, safe, embeddable scripting language. Built on the Checkmate TextMate grammar.",
	"version": "0.1.0",
	"publisher": "cmengine",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/cmengine/checkmate"
	},
	"engines": {
		"vscode": "^1.70.0"
	},
	"categories": ["Programming Languages"],
	"contributes": {
		"languages": [
			{
				"id": "checkmate",
				"aliases": ["Checkmate", "checkmate", "CME"],
				"extensions": [".cm"],
				"configuration": "./language-configuration.json",
				"firstLine": "^#!/.*\\bcme\\b"
			}
		],
		"grammars": [
			{
				"language": "checkmate",
				"scopeName": "source.checkmate",
				"path": "./checkmate.tmLanguage.json"
			}
		]
	}
}
