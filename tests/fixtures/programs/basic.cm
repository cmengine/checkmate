// Canonical positive fixture: parse_source must return ZERO diagnostics forever.
// Feature inventory: functions with typed parameters and return types, recursion,
// return with and without a value, if / else if / else, while, braced blocks,
// int / float / str / bool / infer declarations, plain and compound assignment,
// arithmetic, comparison, mandatory logical parenthesization, unary - and !,
// string concatenation with +, and positional user-defined function calls.

int fib(int n) {
    if (n <= 1) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

void append_report(int value, str title) {
    str report = title + ": " + value + "\n"
}

int classify(int score) {
    bool low = score < 10
    bool ready = (score > 50 && score < 90) || score == 100

    if (low) {
        return 0
    } else if (score >= 90) {
        return 2
    } else if (ready) {
        return 1
    } else {
        return -1
    }
}

int main() {
    int count = 0
    int total = 0
    float weight = 2.5
    str status = "start"
    bool active = true
    infer message = "checkmate"

    while (count < 5) {
        total += fib(count)
        count += 1
    }

    total *= 2
    total -= 3
    total /= 3
    total %= 4
    weight *= 1.5
    status += " " + message

    if (total == 0) {
        active = !active
    }

    if (weight > 2.0) {
        status += " heavy"
    } else if (weight == 2.0) {
        status += " exact"
    } else {
        status += " light"
    }

    append_report(total, status)
    return total
}
